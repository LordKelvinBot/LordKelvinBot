{
  "name": "lord-kelvin-bot",
  "version": "2.0.0",
  "description": "A feature-rich Discord bot with AI chat, weather, gambling, and more",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Kyle Chau",
  "license": "MIT",
  "dependencies": {
    "@discordjs/core": "^2.0.1",
    "@discordjs/formatters": "^0.6.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "@openai/realtime-api-beta": "github:openai/openai-realtime-api-beta",
    "ansi-regex": "^6.1.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "ffmpeg-binaries": "^3.2.2-3",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.95.1",
    "opus-decoder": "^0.7.7",
    "opusscript": "^0.0.8",
    "p-limit": "^6.2.0",
    "package.json": "^0.0.0",
    "prism-media": "^2.0.0-alpha.0",
    "snekfetch": "^4.0.4",
    "superagent": "^4.0.0-beta.5",
    "tough-cookie": "^4.1.3",
    "urban": "^0.3.2",
    "wave-resampler": "^1.0.0",
    "weather-js": "^2.0.0",
    "ws": "^8.18.1",
    "xml2js": "^0.6.2",
    "yargs": "^17.6.0",
    "yargs-parser": "^21.1.1",
    "ytdl-core": "^0.18.7"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "utils/**/*.js",
      "commands/**/*.js",
      "!**/node_modules/**"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
